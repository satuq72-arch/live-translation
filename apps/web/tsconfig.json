{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@saas/core":                   ["../../packages/core/src/index.ts"],
      "@saas/core/ws-gateway/client": ["../../packages/core/src/ws-gateway/client.ts"],
      "@saas/core/auth/clerk":        ["../../packages/core/src/auth/clerk.ts"],
      "@saas/shared":                 ["../../packages/shared/src/index.ts"]
    },
    "allowJs": true,
    "noEmit": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
